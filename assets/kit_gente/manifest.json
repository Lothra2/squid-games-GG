dros":4,"fps":10,"loop":true},"grab_hold":{"cuadros":4,"fps":8,"loop":true},"fall_off":{"cuadros":8,"fps":10,"loop":false},"dash":{"cuadros":6,"fps":16,"loop":false},"edge_teeter":{"cuadros":8,"fps":10,"loop":true},"jab":{"cuadros":6,"fps":16,"loop":false},"balance_walk":{"cuadros":8,"fps":8,"loop":true},"throw":{"cuadros":6,"fps":12,"loop":false},"dodge_jump":{"cuadros":8,"fps":14,"loop":false}}}},"retratos":{"archivo":"atletas/j_yuli/retratos.png","chico":40,"grande":96,"expresiones":["neutral","feliz","enojo","triste","susto","cerrado","dolor","burla"],"escala_grande":1}},"j_yusmary":{"nombre":"Jugador 386","celda":64,"pivote":[32,62],"numero":"386","packs":{"base":{"atlas":"atletas/j_yusmary/base.json","imagen":"atletas/j_yusmary/base.png","anims":{"idle":{"cuadros":8,"fps":6,"loop":true},"walk":{"cuadros":8,"fps":10,"loop":true},"run":{"cuadros":8,"fps":14,"loop":true},"jump":{"cuadros":10,"fps":12,"loop":false},"hit":{"cuadros":6,"fps":12,"loop":false},"knockout":{"cuadros":10,"fps":10,"loop":false},"fall_getup":{"cuadros":12,"fps":10,"loop":false},"celebrate":{"cuadros":8,"fps":10,"loop":true},"sad":{"cuadros":8,"fps":5,"loop":true},"dizzy":{"cuadros":8,"fps":8,"loop":true},"stagger":{"cuadros":8,"fps":10,"loop":false}}},"juegos":{"atlas":"atletas/j_yusmary/juegos.json","imagen":"atletas/j_yusmary/juegos.png","anims":{"judo_grip":{"cuadros":4,"fps":10,"loop":true},"grab_hold":{"cuadros":4,"fps":8,"loop":true},"fall_off":{"cuadros":8,"fps":10,"loop":false},"dash":{"cuadros":6,"fps":16,"loop":false},"edge_teeter":{"cuadros":8,"fps":10,"loop":true},"jab":{"cuadros":6,"fps":16,"loop":false},"balance_walk":{"cuadros":8,"fps":8,"loop":true},"throw":{"cuadros":6,"fps":12,"loop":false},"dodge_jump":{"cuadros":8,"fps":14,"loop":false}}}},"retratos":{"archivo":"atletas/j_yusmary/retratos.png","chico":40,"grande":96,"expresiones":["neutral","feliz","enojo","triste","susto","cerrado","dolor","burla"],"escala_grande":1}}},"notas":["Hojas: fila = dirección (orden de `filas`), columna = cuadro. El pivote es el punto de apoyo (pies) y no se mueve.","eventos: en qué cuadro cae cada paso, golpe (impacto), despegue, suelta (pelota, bala, jabalina, hechizo), aterrizaje y brazada (la mano entra al agua).","avance: pixeles que avanza el cuerpo en un ciclo sin patinar. Ritmo = velocidad_del_juego * cuadros / (avance * fps).","elevacion: pixeles que el juego sube el sprite en cada cuadro (saltos que no caben en la celda); la sombra queda en el piso.","agua: fila de la superficie en la celda; el juego puede dibujar su piscina detrás y el nadador ya trae el tinte y las gotas.","desplazamiento: en las acciones que avanzan (salto largo, clavado, remate), pixeles que el juego mueve el sprite hacia donde mira, acumulados desde el primer cuadro.","rumbo: en las pruebas de campo, de frente y de espalda se dibuja la diagonal más cercana; rumbo dice hacia dónde moverlo en cada fila.","packs: un atlas por pack (JSON Hash de TexturePacker, para this.load.atlas de Phaser). Cada cuadro se llama <anim>_<fila>_<cuadro>, con la fila por nombre (right, down...) y el cuadro desde 0.","retratos.png: arriba los chicos de 40 x 40 (el i en x = i * 40), abajo los grandes de 96 x 96 (el i en x = i * 96, y = 40), en el orden de `expresiones`. El grande es la cabeza y los hombros redibujados a 96, con contorno de un pixel (escala_grande 1: ya no es el sprite x3)."]}